{
  "name": "@turing-weique/office-meta-parser",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./docx": {
      "types": "./dist/docx/index.d.ts",
      "default": "./dist/docx/index.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx/index.d.ts",
      "default": "./dist/xlsx/index.js"
    },
    "./pptx": {
      "types": "./dist/pptx/index.d.ts",
      "default": "./dist/pptx/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:codec": "tsx tests/scripts/codec-test.ts",
    "generate:fixtures": "tsx tests/scripts/generate-fixtures.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.0",
    "jszip": "^3.10.0"
  }
}
